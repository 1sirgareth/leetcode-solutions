int mySqrt(int x) 
{
    int root = 0;
    if (x == 2147483647)
    {
        return 46340;
    }

    while (root*root < x)
    {
        long long m = root * root;
        long long n = (root+1)*(root+1);
        
        if (m <= x && n > x)
        {
            break;
        }
        root++;
    }
    return root;   
}
